# ── PostgreSQL ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:securepassword@localhost:5432/tg_tracker

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_HOURS=72

# ── Security ────────────────────────────────────────────────────────────
# REQUIRED: used to sign correlation tokens (Telegram deep links). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-random-string-at-least-32-chars-long

# Optional: 32+ char key to encrypt per-account secrets (Meta tokens, bot tokens) at rest.
# If empty, secrets are stored as-is (still not logged). Set once, never change without migration.
ENCRYPTION_KEY=

# ── Master Bot (OPTIONAL — only needed for Telegram login/tracking) ──────
MASTER_BOT_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Your own Telegram ID (OPTIONAL) ───────────────────────────────────────
ADMIN_TELEGRAM_ID=987654321

# ── Username/password login ───────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-something-long-and-random

# ── Telegram API (only needed once you add bot/personal accounts) ────────
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# ── Sessions directory ──────────────────────────────────────────────────
SESSIONS_DIR=./sessions

# ── Public base URL ─────────────────────────────────────────────────────
BASE_URL=http://localhost:8000

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_JSON=false

# ── Click rate limiting ─────────────────────────────────────────────────
CLICK_RATE_LIMIT_MAX=20
CLICK_RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HOPS=1
FILTER_CRAWLERS=true

# ── Attribution ─────────────────────────────────────────────────────────
# last_touch | first_touch | last_non_direct
ATTRIBUTION_MODEL=last_touch
ATTRIBUTION_WINDOW_HOURS=168
ATTRIBUTION_INCLUDE_ORGANIC=false
CORRELATION_TOKEN_TTL_SECONDS=21600

# ── Privacy / retention ─────────────────────────────────────────────────
DATA_RETENTION_DAYS=365
CLICK_RETENTION_DAYS=0
ANONYMIZE_IPS=false
GEO_LOOKUP_ENABLED=false

# ── Meta ─────────────────────────────────────────────────────────────────
META_GRAPH_VERSION=v21.0
META_TIMEOUT_SECONDS=12
ENABLE_BROWSER_PIXEL=true

# ── Queue ────────────────────────────────────────────────────────────────
QUEUE_MAXLEN=100000
CAPI_MAX_ATTEMPTS=6
CAPI_BACKOFF_BASE_SECONDS=15

# ── Webhooks ─────────────────────────────────────────────────────────────
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_RATE_LIMIT_MAX=120
ALLOW_PRIVATE_URLS_FOR_OUTBOUND_WEBHOOKS=false
