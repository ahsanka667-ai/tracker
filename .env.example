# ── PostgreSQL ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:securepassword@localhost:5432/tg_tracker

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_HOURS=72

# ── Master Bot (OPTIONAL — only needed for Telegram login/tracking) ──────
# Create via @BotFather → /newbot
MASTER_BOT_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Your own Telegram ID (OPTIONAL) ───────────────────────────────────────
# Get from @userinfobot — auto-created as first admin on startup.
# Not required if you use ADMIN_USERNAME/ADMIN_PASSWORD below instead.
ADMIN_TELEGRAM_ID=987654321

# ── Username/password login ───────────────────────────────────────────────
# Lets you log into the dashboard with NO Telegram bot, widget, or domain
# setup at all. Set both and restart — this account is auto-created (or its
# password refreshed) on every startup. This is the recommended way to get
# in for the first time; add Telegram accounts later, only once you're
# ready to actually track.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-something-long-and-random

# ── Telegram API (only needed once you add bot/personal accounts to track
#    Telegram activity — the dashboard itself runs fine without these) ────
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# ── Sessions directory ──────────────────────────────────────────────────
SESSIONS_DIR=./sessions

# ── Public base URL ─────────────────────────────────────────────────────
# For local testing use: http://localhost:8000
# For production use your domain: https://track.yourdomain.com
BASE_URL=http://localhost:8000

# ── Logging ───────────────────────────────────────────────────────────
# Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Rotating log files written here (5MB x 5 files per service)
LOG_DIR=./logs

# ── Click rate limiting (anti-abuse / click-fraud protection) ──────────
# Max click captures allowed per IP within the time window below.
# Real users never hit this — protects against scripts hammering your
# tracking URL to inflate click counts.
CLICK_RATE_LIMIT_MAX=20
CLICK_RATE_LIMIT_WINDOW_SECONDS=60
